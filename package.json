{
  "name": "ciphera-zkp",
  "version": "0.1.0",
  "private": true,
  "description": "A standards-based ZKP credential SDK with reference issuer and wallet simulators",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "node -e \"const fs=require('fs');const p=require('path');require('child_process').execSync('npm run clean --workspaces --if-present',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
