{
  "name": "@breakchain/issuer",
  "version": "0.1.0",
  "description": "Reference Issuer Server — OpenID4VCI-compliant credential issuer for the Breakchain ZKP SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@breakchain/core": "0.1.0",
    "@breakchain/crypto": "0.1.0",
    "@breakchain/credentials": "0.1.0",
    "@breakchain/did": "0.1.0",
    "express": "^4.21.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
