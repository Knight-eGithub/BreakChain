{
  "name": "@breakchain/sdk",
  "version": "0.1.0",
  "description": "Developer-facing SDK for the Breakchain ZKP credential ecosystem — connectWallet, requestProof, verifyPresentation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@breakchain/core": "^0.1.0",
    "@breakchain/crypto": "^0.1.0",
    "@breakchain/did": "^0.1.0",
    "@breakchain/credentials": "^0.1.0",
    "@breakchain/prover": "^0.1.0"
  },
  "devDependencies": {
    "@breakchain/wallet": "^0.1.0",
    "@breakchain/issuer": "^0.1.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Knight-eGithub/BreakChain.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "zkp",
    "zero-knowledge",
    "verifiable-credentials",
    "w3c-vc",
    "did",
    "identity",
    "groth16",
    "snarkjs",
    "circom",
    "sd-jwt"
  ]
}
