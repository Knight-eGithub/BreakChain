{
  "name": "@breakchain/wallet",
  "version": "0.1.0",
  "description": "Reference wallet simulator for the Breakchain ZKP credential ecosystem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@breakchain/core": "^0.1.0",
    "@breakchain/crypto": "^0.1.0",
    "@breakchain/did": "^0.1.0",
    "@breakchain/credentials": "^0.1.0",
    "@breakchain/prover": "^0.1.0",
    "express": "^4.21.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  },
  "license": "MIT"
}
